{
  "name": "overheard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Overheard — duyduğun sözü haritaya bırak. Yalnızca ortak mekânlarında okunur.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "OVERHEARD_DEMO=1 node --watch --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.js",
    "db:check": "node --disable-warning=ExperimentalWarning scripts/db-check.mjs",
    "import:osm": "node --disable-warning=ExperimentalWarning server/import-osm.js",
    "connect": "node scripts/connect.mjs",
    "codespace": "node scripts/codespace.mjs",
    "build:site": "node site/build.mjs"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.56.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "libsql": "^0.5.29"
  }
}
