# Bu dosyayı .env olarak kopyala ve doldur:  cp .env.example .env
# .env gizlidir, git'e girmez.

# ── Zorunlu ──────────────────────────────────────────────────────────
# Telegram'da @BotFather → /newbot → verdiği token
TELEGRAM_BOT_TOKEN=
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Bota yazabilecek Telegram kullanıcı kimlikleri (virgülle). Boş bırakıp bota yazarsan
# kimliğini söyler; buraya ekleyip botu yeniden başlat.
ALLOWED_USERS=

# ── Model ────────────────────────────────────────────────────────────
BOT_MODEL=claude-opus-5-5
# Düşünme seviyesi: low (sohbet için, en ucuz) | medium | high | xhigh | max
# Sohbet içinden /efor ile de değişir.
BOT_EFFORT=low
# Tek cevap için üst sınır (düşünme dahil). Harcama değil, tavandır.
MAX_TOKENS=64000
# Web araması (güncel bilgi). Arama başına ~0,01 $ + sonuç tokenları. /web ile de değişir.
WEB_SEARCH=on
WEB_SEARCH_MAX_USES=3
# Güvenlik filtresi reddederse aynı isteği sunucu tarafında uygun bir yedek modelle dener.
FALLBACKS=on
# Art arda mesajlarda önek önbelleği (okuma ~%95 ucuz). Çok seyrek yazıyorsan off denenebilir.
PROMPT_CACHE=on

# ── Hafıza / token tasarrufu ─────────────────────────────────────────
# İstem bu kadar tokenı geçince eski mesajlar hafıza + özete damıtılır.
COMPACT_AT_TOKENS=8000
# Damıtmada olduğu gibi kalacak son mesaj sayısı (çift sayı).
KEEP_TURNS=4
# Bu kadar dakika sessizlikten sonra sohbet arka planda damıtılır (0 = kapalı).
IDLE_COMPACT_MINUTES=180
# Art arda atılan mesajları birleştirme penceresi (ms).
MERGE_WINDOW_MS=1500
MEMORY_MAX_ITEMS=40
# Damıtma modeli (boş = BOT_MODEL). Daha ucuzu için: claude-haiku-5-5
MEMORY_MODEL=

# ── Hatırlatma ───────────────────────────────────────────────────────
# "Yarın 9'da hatırlat" dediğinde bot zamanı gelince mesaj atar. /hatirlatmalar ile listelenir.
REMINDERS=on

# ── Sesli mesaj (isteğe bağlı) ───────────────────────────────────────
# Claude ses dinlemez; ses önce yazıya çevrilir. Ücretsiz anahtar: https://console.groq.com/keys
STT_API_KEY=
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=tr
# Çevrilen metni sana geri göster (yanlış duyduysa anlarsın).
SHOW_TRANSCRIPT=on

# ── Diğer ────────────────────────────────────────────────────────────
TIMEZONE=Europe/Istanbul
# DATA_DIR=./data
# SKILL_DIR=../.claude/skills/verimli-sohbet
